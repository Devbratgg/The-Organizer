<Window x:Class="TheOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TheOrganizer.Views"
        Title="The Organizer" Height="600" Width="1000"
        Background="#1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" x:Name="SidePanelColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <views:SideMenu Grid.Column="0" x:Name="SideMenuControl"/>

        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

            <views:RightSideHeader x:Name="HeaderControl" Grid.Row="0"/>

            <Grid Grid.Row="1" Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> 
        <RowDefinition Height="*"/>    
    </Grid.RowDefinitions>

    <views:RightSideHeader x:Name="HeaderControl" Grid.Row="0"/>

    <views:EntryListView x:Name="EntryListControl" Grid.Row="1" Panel.ZIndex="1"/>

    <views:AlbumView x:Name="AlbumViewControl" Grid.Row="1" Panel.ZIndex="2" Visibility="Collapsed"/>

    <views:AlbumSubView x:Name="MySubView" Grid.Row="1" Panel.ZIndex="3" Visibility="Collapsed"/>

</Grid>

            <views:EntryListView x:Name="EntryListControl" Grid.Row="1" Panel.ZIndex="1"/>
            <views:AlbumView x:Name="AlbumViewControl" Grid.Row="1" Panel.ZIndex="2" Visibility="Collapsed"/>

            <views:AlbumSubView x:Name="MySubView" Grid.Row="1" Panel.ZIndex="2" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>